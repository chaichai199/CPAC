# Copy this file to .env.local and fill in your Firebase project credentials
# to enable real-time cloud sync via Firestore. If left unset, the app
# automatically runs in LocalStorage fallback mode (simulated real-time
# sync via BroadcastChannel across browser tabs).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
